<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LevelEditorPlus</AssemblyName>
    <RootNamespace>LevelEditorPlus</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <!-- Where Unturned is installed. Override with: dotnet build -p:GamePath="..." -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\Steam\steamapps\common\Unturned</GamePath>
    <GameManaged>$(GamePath)\Unturned_Data\Managed</GameManaged>
    <ModuleInstallDir>$(GamePath)\Modules\LevelEditorPlus</ModuleInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Makes the game's private/internal members accessible at compile time. -->
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="SDG.Glazier.Runtime" />
    <!-- Keep the event's private backing field private to avoid ambiguity. -->
    <DoNotPublicize Include="Assembly-CSharp:SDG.Framework.Rendering.GLRenderer.render" />
    <DoNotPublicize Include="Assembly-CSharp:SDG.Framework.Rendering.GLRenderer.OnGameRender" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Numerics" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDG.Glazier.Runtime">
      <HintPath>$(GameManaged)\SDG.Glazier.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Install into Unturned/Modules after every build. -->
  <Target Name="InstallModule" AfterTargets="Build" Condition="'$(InstallModuleOnBuild)' != 'false'">
    <ItemGroup>
      <ModuleFiles Include="$(TargetDir)LevelEditorPlus.dll" />
      <ModuleFiles Include="$(TargetDir)0Harmony.dll" />
      <ModuleFiles Include="$(MSBuildThisFileDirectory)..\..\module\LevelEditorPlus.module" />
    </ItemGroup>
    <MakeDir Directories="$(ModuleInstallDir)" />
    <Copy SourceFiles="@(ModuleFiles)" DestinationFolder="$(ModuleInstallDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="LevelEditorPlus installed to $(ModuleInstallDir)" />
  </Target>

</Project>
